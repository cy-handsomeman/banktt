# 环境变量模板：复制为同目录下的 .env 后填写真实值
# Windows:  copy .env.example .env
# 注意：.env 已被 .gitignore 忽略，禁止提交到版本库

# ==== Django 基础配置 ====
# 生产环境必须替换为随机长字符串，可用以下命令生成：
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=请替换为随机密钥
DJANGO_DEBUG=True
# 逗号分隔；生产环境填写真实域名
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# 仅当部署在反向代理/负载均衡后面才填写代理 IP，才会信任 X-Forwarded-For；直连部署留空
TRUSTED_PROXY_IPS=

# ==== MySQL 数据库 ====
DB_NAME=bank
DB_USER=root
DB_PASSWORD=请替换为数据库密码
DB_HOST=127.0.0.1
DB_PORT=3306
